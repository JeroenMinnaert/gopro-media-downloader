# For local development: keeps gopro-dl's own state (token, config file,
# browser-login profile, NAS-redirect manifests) inside this repo instead of
# your real ~/Library/Application Support or ~/.config.
#
# With direnv (https://direnv.net) installed and hooked into your shell,
# `direnv allow` once after cloning and this is exported automatically.
# Without direnv, gopro-dl itself reads this line as a fallback (a plain
# text match, not real shell evaluation) -- comment it out to use the real
# OS locations instead. See CLAUDE.md.
export GOPRO_DL_HOME="$PWD/.dev-state"
