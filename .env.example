# `gopro-dl setup` writes these automatically to one fixed location --
# ~/Library/Application Support/gopro-dl/config.env on macOS,
# ~/.config/gopro-dl/config.env on Linux -- same file no matter which
# directory you run gopro-dl from. This is just a reference for every
# available key; only edit the real file if you want to override something
# by hand.

# Bearer JWT from the gp_access_token cookie on gopro.com
# (see docs/getting-a-token.md).
# Prefer GOPRO_TOKEN_FILE for long runs: the file can be updated while the
# downloader is running, so an expired token does not cost you progress.
# `gopro-dl setup` already picks a sensible per-OS default location for this
# (e.g. ~/Library/Application Support/gopro-dl/token on macOS) -- only set it
# here to point at a different file.
GOPRO_TOKEN=
GOPRO_TOKEN_FILE=

# Optional; only needed if the cookie auth fallback kicks in.
GOPRO_USER_ID=

# Where media is written. Date folders (YYYY-MM-DD) are created inside it.
# `gopro-dl setup` already defaults this to ~/Downloads/GoPro and lets you
# override it interactively -- only set it here to point at a different path.
GOPRO_DEST=

# Keep the manifest OFF a network share: SMB does not support SQLite WAL.
# Only set this when GOPRO_DEST is a NAS/SMB mount.
# GOPRO_MANIFEST_DIR=~/gopro-backup/.gopro-dl

# GoPro almost never returns a capture timezone, so folder dates would default
# to UTC and clips shot late in the evening would land a day early. Set your
# home timezone; a timezone the API does supply always wins.
GOPRO_TIMEZONE=Europe/Paris

# Parallel downloads. 3 is polite and plenty for a home connection.
GOPRO_CONCURRENCY=3

# Where gopro-dl keeps its OWN state -- the saved token, this config file, the
# browser-login profile, and any manifests redirected off a network share.
# Unset, it defaults to the OS's per-user location (~/Library/Application
# Support/gopro-dl on macOS, ~/.config/gopro-dl on Linux). This is the only
# thing that decides that location. Set it to keep everything in one mounted
# directory -- which is what docker-compose.example.yml does.
# Environment-only: this file's own location is derived from it, so setting it
# here is too late to have any effect.
# GOPRO_DL_HOME=/config
